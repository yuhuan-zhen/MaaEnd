{
    "CheckMenuListColor": {
        "desc": "【网页端覆盖 · 云串流适配】检查菜单列表界面左下角颜色。上游原判据 lower=[90,35,35] upper=[191,83,85] 在云·终末地上只命中 23/17 像素（需 ≥100）⇒ InMenuList 不过 ⇒ 所有要走「进入菜单」的任务 20 秒超时失败（实测 2026-10-17：VisitFriends / DijiangRewards / DailyRewards 全卡这里）。用 MaaFramework 自己的 ColorMatch 逐维扫描（不要用自写 HSV 模拟，两者数量级会差很多：框架报的是最大连通块像素数）：只改 V 上下界几乎无效（23→24），真正的杠杆是**饱和度上界**——云端画面被做了对比度/饱和度拉伸，该区域饱和度超过上游 83 的上限。故仅把 upper 的 S 由 83 放宽到 130，其余阈值与 count 全部保持上游值。实测：正样本 168/152（过），负对照「大世界内」75、「云启动页」2（均在阈值下，区分力保留）。",
        "recognition": "ColorMatch",
        "roi": [
            0,
            -200,
            200,
            200
        ],
        "lower": [
            90,
            35,
            35
        ],
        "upper": [
            191,
            130,
            85
        ],
        "count": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "__ScenePrivateWorldEnterMenuList": {
        "desc": "【网页端覆盖 · 云串流适配】从大世界进入菜单总列表。上游 next 是 [__SceneImageCheck, __ScenePrivateAnyEnterMenuListSuccess]：前者会点左下角，期待弹出「登录界面/确认」登出对话框，再借那张对话框做 OSD/Mod/画面颜色/语言/抓 UID 五项 PC 渲染自检。云端实测（2026-10-17 15:31~15:33 日志）：点击后画面回到大世界、登出对话框从未出现 ⇒ __SceneImageCheckDialogIn 在 20 秒内空转 5640 次全部落空 ⇒ 任务失败。这五项自检对浏览器/云串流无意义：OSD 遮挡与 Mod 检测针对 PC 客户端；CaptureUid 在 Win32 控制器下读游戏注册表，而浏览器无该注册表项。故这里只保留「Alt+点开菜单」与「确认已在菜单列表」两步，去掉整条自检链。ImageCheckNotPassedRecognition 仅被 __SceneImageCheck 使用（已核），跳过不影响其他节点。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    -200,
                    0,
                    200,
                    200
                ],
                "template": [
                    "SceneManager/WorldMenu.png"
                ],
                "green_mask": true
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "timeout": 1000
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilFoundAction",
                "custom_action_param": {
                    "custom_action": "AutoAltClickAction",
                    "interval_ms": 6000,
                    "wait_nodes": [
                        "__ScenePrivateAnyEnterMenuListSuccess"
                    ]
                },
                "target_offset": [
                    5,
                    5,
                    -10,
                    -10
                ]
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateAnyEnterMenuListSuccess"
        ]
    },
    "WebStartGameEntry": {
        "desc": "【网页端 · 启动器】点一次运行就完成「开始游戏 → 排队/加载 → 进入游戏」。已经在游戏里（大世界或菜单）则直接跳过；已在排队则只等待。浏览器窗口需要先用 2-启动网页端.bat 打开并连上。timeout 给 10 分钟：游戏加载阶段是黑屏（三个判据都不命中），预算太短会误判失败。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
