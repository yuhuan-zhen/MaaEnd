        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    300,
                    680,
                    400
                ],
                "expected": [
                    // 完整原文："结束拜访"（英文 End Visit 的空格宽度不稳，用 (?i) 正则）
