    // 实测 23/17 像素（需 ≥100）⇒ InMenuList 不过 ⇒ 所有「进入菜单」类任务 20 秒超时。
    // V 上下界几乎无效（23→24），S 上界才是杠杆；其余阈值与 count 保持上游值。
    "CheckMenuListColor": {
        "desc": "【网页端覆盖 · 云串流适配】检查菜单列表界面左下角颜色。上游原判据 lower=[90,35,35] upper=[191,83,85] 在云·终末地上只命中 23/17 像素（需 ≥100）⇒ InMenuList 不过 ⇒ 所有要走「进入菜单」的任务 20 秒超时失败（实测 2026-10-17：VisitFriends / DijiangRewards / DailyRewards 全卡这里）。用 MaaFramework 自己的 ColorMatch 逐维扫描（不要用自写 HSV 模拟，两者数量级会差很多：框架报的是最大连通块像素数）：只改 V 上下界几乎无效（23→24），真正的杠杆是**饱和度上界**——云端画面被做了对比度/饱和度拉伸，该区域饱和度超过上游 83 的上限。故仅把 upper 的 S 由 83 放宽到 130，其余阈值与 count 全部保持上游值。实测：正样本 168/152（过），负对照「大世界内」75、「云启动页」2（均在阈值下，区分力保留）。",
        "recognition": "ColorMatch",
        "roi": [
            0,
            -200,
            200,
            200
        ],
        "lower": [
            90,
            35,
            35
        ],
        "upper": [
            191,
            130,
            85
        ],
        "count": 100,
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
